{
  "name": "@lodado/eslint-plugin-sdui",
  "version": "0.0.0",
  "description": "ESLint rules that prevent SDUI hook data from being forwarded through multiple components",
  "license": "MIT",
  "author": "lodado",
  "type": "commonjs",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "rules/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "sdui",
    "react",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lodado/sdui-template.git",
    "directory": "packages/eslint-plugin-sdui"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0",
    "@typescript-eslint/parser": "^5.62.0 || ^8.0.0",
    "typescript": ">=5.4.0 <6"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^5.62.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint --no-eslintrc --config .eslintrc.cjs index.js rules tests --ext .js,.cjs",
    "build": "node --check index.js && node --check rules/no-hook-data-prop-drilling.js && node --check rules/analyze.js"
  }
}
